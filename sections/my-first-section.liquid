<style>
    h1{
    padding-top: {{ section.settings.padding }}px;
    font_size: {{ section.settings.headingfont_size }}px;
    }
</style>

<div class="page-width">
   <h1 style="text-align:{{ section.settings.heading_alignment }};">{{section.settings.heading_text}}</h1>
   <p>{{ section.settings.paragraph_text }}</p>
   {% if section.settings.mylucky_number > 0 %}
     {{ section.settings.mylucky_number }}
   {% endif %}
   
</div>

{%schema%}
{
 "name": "Class 1",
 "settings": [
    {
        "type": "text",
        "id": "heading_text",
        "label": "Heading"
    },
    {
        "type": "textarea",
        "id": "paragraph_text",
        "label": "Paragraph",
        "default":"Tell about yourself"
    },
    {
        "type": "number",
        "id": "mylucky_number",
        "label": "Lucky number",
        "default": 7
    },
    {
        "type": "range",
        "id": "padding",
        "label": "Padding Top",
        "min": 5,
        "max": 100,
        "default": 5,
        "step": 5,
        "unit": "px"
    },
    {
         "type": "range",
        "id": "headingfont_size",
        "label": "Hading Font Size",
        "min": 5,
        "max": 100,
        "default": 5,
        "step": 5,
        "unit": "px" 
    },
    {
    "type": "select",
    "id": "heading_alignment",
    "label": "Heading Alignment",
    "options": [
        {
            "value": "left",
            "label": "Left Align"
        },
        {
            "value": "center",
            "label": "Center Align"
        },
        {
            "value": "right",
            "label": "Right Align"
        }
    ],
    "default": "center"
    }

 ],
 "blocks": [],
 "presets": [
    {
    "name": "Class 1"
    }
 ]

}
{%endschema%}